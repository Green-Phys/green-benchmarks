#!/bin/bash
# env.sh.template — copy to env.sh and fill in site-specific values.
# env.sh is gitignored (per-machine). Defaults here document the intended
# values; tune in your local env.sh copy, not here.
#
# Usage: copy this file to env.sh and edit the REQUIRED fields below.

# ── Required ────────────────────────────────────────────────────────────────
export BENCH_ROOT="${BENCH_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
export BENCH_SCRATCH="${BENCH_SCRATCH:-/scratch/$USER/green-benchmarks}"

# Path to a green-ac build (ac.exe must be executable there).
export GREEN_AC="${GREEN_AC:-/path/to/green-ac/build}"

# ── Partition names ──────────────────────────────────────────────────────────
export SLURM_PARTITION_AUX="${SLURM_PARTITION_AUX:-standard}"
export SLURM_PARTITION_MBPT="${SLURM_PARTITION_MBPT:-standard}"
export SLURM_PARTITION_GPU="${SLURM_PARTITION_GPU:-gpu}"

# ── INIT resources ───────────────────────────────────────────────────────────
export SLURM_INIT_CPUS="${SLURM_INIT_CPUS:-16}"
export SLURM_INIT_TIME="${SLURM_INIT_TIME:-01:00:00}"

# ── MBPT (CPU) resources ─────────────────────────────────────────────────────
export SLURM_MBPT_NODES="${SLURM_MBPT_NODES:-1}"
export SLURM_MBPT_NTASKS_PER_NODE="${SLURM_MBPT_NTASKS_PER_NODE:-32}"
export SLURM_MBPT_CPUS="${SLURM_MBPT_CPUS:-2}"
export SLURM_MBPT_TIME="${SLURM_MBPT_TIME:-06:00:00}"
export SLURM_MBPT_EXTRA="${SLURM_MBPT_EXTRA:---exclusive}"

# ── MBPT GPU resources ───────────────────────────────────────────────────────
export MBPT_GPU="${MBPT_GPU:-1}"                  # set to 0 to disable GPU mbpt + ac_gpu
export SLURM_MBPT_GPU_NODES="${SLURM_MBPT_GPU_NODES:-1}"
export SLURM_MBPT_GPU_NTASKS_PER_NODE="${SLURM_MBPT_GPU_NTASKS_PER_NODE:-1}"
export SLURM_MBPT_GPU_GPUS_PER_NODE="${SLURM_MBPT_GPU_GPUS_PER_NODE:-1}"
export SLURM_MBPT_GPU_CPUS="${SLURM_MBPT_GPU_CPUS:-8}"
export SLURM_MBPT_GPU_TIME="${SLURM_MBPT_GPU_TIME:-06:00:00}"
export SLURM_MBPT_GPU_EXTRA="${SLURM_MBPT_GPU_EXTRA:-}"

# AC_GPU: whether to run analytic continuation on the GPU-MBPT output.
# Empty (default) → inherits MBPT_GPU in submit_chain.sh (i.e. AC runs iff
# GPU MBPT ran). Set to 0 to suppress ac_gpu even when MBPT_GPU=1.
export AC_GPU="${AC_GPU-}"

# ── AC resources (reused for both ac and ac_gpu — ac_gpu is the same CPU job) ─
export SLURM_AC_NODES="${SLURM_AC_NODES:-1}"
export SLURM_AC_NTASKS_PER_NODE="${SLURM_AC_NTASKS_PER_NODE:-16}"
export SLURM_AC_CPUS="${SLURM_AC_CPUS:-2}"
export SLURM_AC_TIME="${SLURM_AC_TIME:-02:00:00}"
