# env.sh.template — copy to env.sh on pauli and fill in.
#
# `env.sh` is gitignored. It holds the per-machine paths the harness
# needs and must not be committed. Source it from every shell that
# will submit or rerun benchmarks:
#
#     source $BENCH_ROOT/env.sh
#
# green-mbtools lives in a per-version conda env. activate_env.sh
# `conda activate`s the right one based on $GREEN_VER.

# --- working tree + scratch -------------------------------------------------
export BENCH_ROOT="${BENCH_ROOT:-$HOME/codes/green-benchmarks}"   # this repo
export BENCH_SCRATCH="${BENCH_SCRATCH:-/pauli-storage/$USER/green-benchmarks}"
mkdir -p "$BENCH_SCRATCH"

# HDF5 file locking must be off on the shared parallel FS (pauli-storage):
# every init/mbpt/ac run opens .h5 files and concurrent opens fail otherwise.
# (mbpt.sbatch also sets this explicitly; kept here so it applies globally.)
export HDF5_USE_FILE_LOCKING=FALSE

# --- SLURM partitions -------------------------------------------------------
# A fast one for the heavy MBPT job, a pedestrian one for init + AC, and a
# GPU one for the GPU MBPT job.
export SLURM_PARTITION_MBPT="ludicrous"   # for templates/mbpt.sbatch (the heavy job)
export SLURM_PARTITION_AUX="super"        # for templates/init.sbatch + templates/ac.sbatch
export SLURM_PARTITION_GPU="${SLURM_PARTITION_GPU:-blackwell}"   # for the GPU MBPT job
# export SLURM_ACCOUNT="TBD"              # optional; comment out if unused

# --- per-phase job resources ------------------------------------------------
# Read by tools/submit_chain.sh; tune for your cluster. A system's submit.sh
# may override any of them by exporting the variable before sourcing
# submit_chain.sh. INIT is always single node / single task (multi-threaded via
# cpus-per-task); only its cpus/time are tunable.
export SLURM_INIT_CPUS="${SLURM_INIT_CPUS:-16}"
export SLURM_INIT_TIME="${SLURM_INIT_TIME:-01:00:00}"

# MBPT — the heavy MPI job.
export SLURM_MBPT_NODES="${SLURM_MBPT_NODES:-1}"
export SLURM_MBPT_NTASKS_PER_NODE="${SLURM_MBPT_NTASKS_PER_NODE:-32}"
export SLURM_MBPT_CPUS="${SLURM_MBPT_CPUS:-2}"
export SLURM_MBPT_TIME="${SLURM_MBPT_TIME:-06:00:00}"
export SLURM_MBPT_EXTRA="${SLURM_MBPT_EXTRA---exclusive}"   # extra sbatch flags; set to "" to disable (no ':' so an empty override is kept)

# MBPT GPU — an extra mbpt.exe --kernel GPU job on a GPU node. Set MBPT_GPU=0 to
# skip it (and its ac_gpu). Ntasks-per-node is typically one MPI rank per GPU.
export MBPT_GPU="${MBPT_GPU:-1}"
export SLURM_MBPT_GPU_NODES="${SLURM_MBPT_GPU_NODES:-1}"
export SLURM_MBPT_GPU_NTASKS_PER_NODE="${SLURM_MBPT_GPU_NTASKS_PER_NODE:-1}"
export SLURM_MBPT_GPU_GPUS_PER_NODE="${SLURM_MBPT_GPU_GPUS_PER_NODE:-1}"
export SLURM_MBPT_GPU_CPUS="${SLURM_MBPT_GPU_CPUS:-8}"
export SLURM_MBPT_GPU_TIME="${SLURM_MBPT_GPU_TIME:-06:00:00}"
export SLURM_MBPT_GPU_EXTRA="${SLURM_MBPT_GPU_EXTRA-}"   # extra sbatch flags (no ':' so an empty is kept)

# AC — analytic continuation (MPI). The same resources/partition are reused for
# the gpu-source AC (ac_gpu is the SAME CPU ac.exe on the GPU MBPT output).
export SLURM_AC_NODES="${SLURM_AC_NODES:-1}"
export SLURM_AC_NTASKS_PER_NODE="${SLURM_AC_NTASKS_PER_NODE:-16}"
export SLURM_AC_CPUS="${SLURM_AC_CPUS:-2}"
export SLURM_AC_TIME="${SLURM_AC_TIME:-02:00:00}"

# AC_GPU: whether to run analytic continuation on the GPU-MBPT output. Empty
# (default) → inherits MBPT_GPU in submit_chain.sh (AC runs iff GPU MBPT ran).
# Set to 0 to suppress ac_gpu even when MBPT_GPU=1.
export AC_GPU="${AC_GPU-}"

# --- green-mbpt (the compiled binary) --------------------------------------
# Wherever `mbpt.exe` and friends live for each release. activate_env.sh
# prepends $GREEN_ROOT/bin to PATH and $GREEN_ROOT/lib to LD_LIBRARY_PATH.
export GREEN_ROOT_V032="$HOME/software/GREEN/mbpt-cpu-install-v0.3.2"
export GREEN_ROOT_V100A0="$HOME/software/GREEN/mbpt-cpu-install-v1.0.0a0"

# --- green-ac (analytic continuation; version-independent) ------------------
# ac.exe is shared across all Green versions, so its build dir goes on PATH
# here in env.sh (not activate_env.sh, which is per-version).
export GREEN_AC="$HOME/codes/green-ac/build"   # dir containing ac.exe
export PATH="$GREEN_AC:$PATH"

# --- green-mbtools (per-version conda envs) --------------------------------
# Each env must already exist and have green-mbtools (+ pyscf, h5py,
# numpy, etc.) importable. activate_env.sh runs `conda activate $env`.
export MBTOOLS_V032_CONDA_ENV="mbtools-v0.3.0"
export MBTOOLS_V100A0_CONDA_ENV="mbtools-v1.0.0"

# Conda install that owns those envs. Used by activate_env.sh to source
# $CONDA_BASE/etc/profile.d/conda.sh. Common: $HOME/miniconda3, /opt/conda.
export CONDA_BASE="${CONDA_BASE:-$HOME/miniconda3}"
